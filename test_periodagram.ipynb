   "source": [
    "ys = np.cos(2*np.pi*(np.arange(80))/12) + 1\n",
    "\n",
    "a, b = periodogram(ys, 1)\n",
    "plt.plot(a,b)\n",
    "\n",
    "1/(a[np.argmax(b)])"
   ]
